#include "I2C.h"

/**
  * @brief 	I2C_PeriphCmd, Enable or Disable SPI Peripheral
  *
  * @param  I2Cx = User Config Structure
  *
  * @param  FunctionalState_t = ENABLE or DISABLE
  *
  * @retval Void
  */
void I2C_PeriphCmd(I2C_TypeDef_t *I2Cx, FunctionalState_t stateOfI2C)
{
	if (stateOfI2C == ENABLE)
	{
		I2Cx->CR1 |= (0x1U << I2C_CR1_PE);
	}
	else
	{
		I2Cx->CR1 &= ~(0x1U << I2C_CR1_PE);
	}
}
